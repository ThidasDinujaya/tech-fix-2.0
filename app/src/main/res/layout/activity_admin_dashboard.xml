<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ========================= -->
    <!-- MAIN DASHBOARD CONTENT -->
    <!-- ========================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white">

        <!-- TOP HEADER -->

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarAdmin"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@color/brand_blue"
            android:paddingTop="20dp"
            app:contentInsetStart="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:id="@+id/imgAdminMenu"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_menu"
                    android:padding="4dp"
                    android:contentDescription="Menu" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Admin Dashboard"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </RelativeLayout>

        </androidx.appcompat.widget.Toolbar>


        <!-- DASHBOARD BODY -->

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- ========================= -->
                <!-- STATISTICS ROW 1 -->
                <!-- ========================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_card_blue"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Bookings"
                            android:textColor="@color/gray_700"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/txtTotalBookings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="128"
                            android:textColor="@color/brand_blue"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:layout_marginTop="7dp" />

                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_card_orange"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pending Repairs"
                            android:textColor="@color/gray_700"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/txtPendingRepairs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="32"
                            android:textColor="#F57C00"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:layout_marginTop="7dp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- ========================= -->
                <!-- STATISTICS ROW 2 -->
                <!-- ========================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_card_green"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Completed"
                            android:textColor="@color/gray_700"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/txtCompleted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="96"
                            android:textColor="#159447"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:layout_marginTop="7dp" />

                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_card_purple"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Revenue"
                            android:textColor="@color/gray_700"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/txtTotalRevenue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LKR 256,000"
                            android:textColor="#3F51B5"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_marginTop="7dp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- DIVIDER -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="20dp" />


                <!-- QUICK ACCESS -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick Access"
                    android:textColor="#111111"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="18dp" />


                <!-- ========================= -->
                <!-- QUICK ACCESS ROW 1 -->
                <!-- ========================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- INVENTORY HUB -->
                    <LinearLayout
                        android:id="@+id/cardInventory"
                        android:layout_width="0dp"
                        android:layout_height="105dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:background="@drawable/bg_quick_icon"
                            android:padding="14dp"
                            android:src="@drawable/ic_parts"
                            android:contentDescription="Inventory" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Inventory"
                            android:textSize="13sp"
                            android:layout_marginTop="7dp" />

                    </LinearLayout>

                    <!-- BOOKINGS -->
                    <LinearLayout
                        android:id="@+id/cardBookings"
                        android:layout_width="0dp"
                        android:layout_height="105dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:background="@drawable/bg_quick_icon"
                            android:padding="14dp"
                            android:src="@drawable/ic_bookings"
                            android:contentDescription="Bookings" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bookings"
                            android:textSize="13sp"
                            android:layout_marginTop="7dp" />

                    </LinearLayout>

                    <!-- SERVICES -->
                    <LinearLayout
                        android:id="@+id/cardServices"
                        android:layout_width="0dp"
                        android:layout_height="105dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:background="@drawable/bg_quick_icon"
                            android:padding="14dp"
                            android:src="@drawable/ic_services"
                            android:contentDescription="Services" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Services"
                            android:textSize="13sp"
                            android:layout_marginTop="7dp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- ========================= -->
                <!-- QUICK ACCESS ROW 2 -->
                <!-- ========================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <!-- TECHNICIANS -->
                    <LinearLayout
                        android:id="@+id/cardTechnicians"
                        android:layout_width="0dp"
                        android:layout_height="105dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:background="@drawable/bg_quick_icon"
                            android:padding="14dp"
                            android:src="@drawable/ic_technician"
                            android:contentDescription="Technicians" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Technicians"
                            android:textSize="13sp"
                            android:layout_marginTop="7dp" />

                    </LinearLayout>

                    <!-- BRANCHES -->
                    <LinearLayout
                        android:id="@+id/cardBranches"
                        android:layout_width="0dp"
                        android:layout_height="105dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:background="@drawable/bg_quick_icon"
                            android:padding="14dp"
                            android:src="@drawable/ic_location"
                            android:contentDescription="Branches" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Branches"
                            android:textSize="13sp"
                            android:layout_marginTop="7dp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>


    <!-- ========================= -->
    <!-- LEFT NAVIGATION DRAWER -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/adminDrawer"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TechFix"
            android:textColor="@color/brand_blue"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="25dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Administrator"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="30dp" />

        <TextView
            android:id="@+id/menuDashboard"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:text="Dashboard"
            android:textColor="@color/brand_blue"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingStart="10dp" />

        <TextView
            android:id="@+id/menuAdminProfile"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:text="Admin Profile"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:paddingStart="10dp" />

        <TextView
            android:id="@+id/menuSettings"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:text="Settings"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:paddingStart="10dp" />

        <TextView
            android:id="@+id/menuSyncFirebase"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:text="Sync to Cloud"
            android:textColor="@color/brand_blue"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingStart="10dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/menuCustomerLogin"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:text="Customer Login"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:paddingStart="10dp" />

        <TextView
            android:id="@+id/menuLogout"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:text="Logout"
            android:textColor="@color/error"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingStart="10dp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>