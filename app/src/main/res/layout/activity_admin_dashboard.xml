<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ========================= -->
    <!-- MAIN DASHBOARD CONTENT -->
    <!-- ========================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white">

        <!-- TOP HEADER -->

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarAdmin"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@color/brand_blue"
            android:paddingTop="20dp"
            app:contentInsetStart="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:id="@+id/imgAdminMenu"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_menu"
                    android:padding="4dp"
                    android:contentDescription="Menu" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Admin Dashboard"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </RelativeLayout>

        </androidx.appcompat.widget.Toolbar>


        <!-- DASHBOARD BODY -->

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">




                <!-- ========================= -->
                <!-- QUICK ACCESS ROW 1 -->
                <!-- ========================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- INVENTORY -->
                    <LinearLayout
                        android:id="@+id/cardInventory"
                        android:layout_width="0dp"
                        android:layout_height="105dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:background="@drawable/bg_quick_icon"
                            android:padding="14dp"
                            android:src="@drawable/ic_parts"
                            android:contentDescription="Inventory" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Inventory"
                            android:textSize="13sp"
                            android:layout_marginTop="7dp" />

                    </LinearLayout>

                    <!-- BRANCHES -->
                    <LinearLayout
                        android:id="@+id/cardBranches"
                        android:layout_width="0dp"
                        android:layout_height="105dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:background="@drawable/bg_quick_icon"
                            android:padding="14dp"
                            android:src="@drawable/ic_location"
                            android:contentDescription="Branches" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Branches"
                            android:textSize="13sp"
                            android:layout_marginTop="7dp" />

                    </LinearLayout>

                    <!-- TECHNICIANS -->
                    <LinearLayout
                        android:id="@+id/cardTechnicians"
                        android:layout_width="0dp"
                        android:layout_height="105dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:background="@drawable/bg_quick_icon"
                            android:padding="14dp"
                            android:src="@drawable/ic_technician"
                            android:contentDescription="Technicians" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Technicians"
                            android:textSize="13sp"
                            android:layout_marginTop="7dp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- ========================= -->
                <!-- QUICK ACCESS ROW 2 -->
                <!-- ========================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <!-- SERVICES -->
                    <LinearLayout
                        android:id="@+id/cardServices"
                        android:layout_width="0dp"
                        android:layout_height="105dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:background="@drawable/bg_quick_icon"
                            android:padding="14dp"
                            android:src="@drawable/ic_services"
                            android:contentDescription="Services" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Services"
                            android:textSize="13sp"
                            android:layout_marginTop="7dp" />

                    </LinearLayout>

                    <!-- BOOKINGS -->
                    <LinearLayout
                        android:id="@+id/cardBookings"
                        android:layout_width="0dp"
                        android:layout_height="105dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:background="@drawable/bg_quick_icon"
                            android:padding="14dp"
                            android:src="@drawable/ic_bookings"
                            android:contentDescription="Bookings" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bookings"
                            android:textSize="13sp"
                            android:layout_marginTop="7dp" />

                    </LinearLayout>

                    <!-- EMPTY PLACEHOLDER TO MATCH 3-COLUMN ALIGNMENT -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="105dp"
                        android:layout_weight="1" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>


    <!-- ========================= -->
    <!-- LEFT NAVIGATION DRAWER -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/adminDrawer"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TechFix"
            android:textColor="@color/brand_blue"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="25dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Administrator"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="30dp" />

        <TextView
            android:id="@+id/menuDashboard"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:text="Dashboard"
            android:textColor="@color/brand_blue"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingStart="10dp" />

        <TextView
            android:id="@+id/menuAdminProfile"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:text="Admin Profile"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:paddingStart="10dp" />

        <TextView
            android:id="@+id/menuSyncFirebase"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:text="Sync to Cloud"
            android:textColor="@color/brand_blue"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingStart="10dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/menuCustomerLogin"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:text="Customer Login"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:paddingStart="10dp" />

        <TextView
            android:id="@+id/menuLogout"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:text="Logout"
            android:textColor="@color/error"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingStart="10dp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>