<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgAvatar"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@android:drawable/ic_menu_myplaces" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTechName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John Perera"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvTechRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mobile Repair Expert"
                android:textColor="#777777"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTechBranch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Colombo Branch"
                android:textColor="#999999"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvTechStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available"
                android:textColor="#28A745"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnEditTech"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/brand_blue"
            android:contentDescription="Edit" />

        <ImageView
            android:id="@+id/btnDeleteTech"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/error"
            android:contentDescription="Delete" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
