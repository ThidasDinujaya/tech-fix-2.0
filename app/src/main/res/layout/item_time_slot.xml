<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSlotName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:30 AM - 08:45 AM"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSlotBranch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Branch: Colombo Main"
                android:textColor="@color/brand_blue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSlotStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Available"
                android:textColor="@color/success_green"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSlotCapacity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Bookings: 0 / 2"
                android:textColor="@color/gray_700"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditSlot"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Update"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/brand_blue"
            app:cornerRadius="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="65dp"
            android:paddingHorizontal="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteSlot"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:text="Delete"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/error"
            app:cornerRadius="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="65dp"
            android:paddingHorizontal="12dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
