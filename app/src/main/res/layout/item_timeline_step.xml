<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/viewLine"
        android:layout_width="2dp"
        android:layout_height="50dp"
        android:background="@color/gray_400"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/ivIndicator"
        app:layout_constraintStart_toStartOf="@id/ivIndicator"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivIndicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/checkbox_off_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/gray_400" />

    <TextView
        android:id="@+id/tvStepTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Step Title"
        android:textColor="@color/black"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/ivIndicator"
        app:layout_constraintStart_toEndOf="@id/ivIndicator"
        app:layout_constraintTop_toTopOf="@id/ivIndicator" />

    <TextView
        android:id="@+id/tvStepTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="20 May 2024 09:45 AM"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/tvStepTitle"
        app:layout_constraintTop_toBottomOf="@id/tvStepTitle" />

</androidx.constraintlayout.widget.ConstraintLayout>
