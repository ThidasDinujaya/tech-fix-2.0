<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvUnifiedPartName"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="Screen Replacement"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/tvUnifiedCategory"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="Phone"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/tvUnifiedBrand"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="Apple"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/tvUnifiedModel"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="iPhone 15 Pro"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/tvUnifiedQuality"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="Original"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/tvUnifiedBranch"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="Colombo Main"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/tvUnifiedStock"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="25"
        android:textColor="@color/text_primary"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvUnifiedPrice"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="15,000.00"
        android:textColor="@color/brand_blue"
        android:textStyle="bold"
        android:gravity="end" />

</LinearLayout>
